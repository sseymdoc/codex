{
  "name": "codex-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Browser frontend for the Codex app-server, styled after the open-claude-ui design language.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "codex-ui": "server/main.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs src/lib/*.test.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.50.0",
    "marked": "^18.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}

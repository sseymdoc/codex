{
  "name": "codex-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Browser frontend for the Codex app-server, styled after the open-claude-ui design language.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "codex-ui": "server/main.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/main.mjs",
    "desktop": "vite build && electron .",
    "package:desktop": "vite build && electron-packager . \"Codex UI\" --out=out --overwrite --icon=desktop/icon.ico --ignore=\"^/(src|public|node_modules|index\\.html|tsconfig\\.json|vite\\.config\\.mjs|README\\.md)\" --ignore=\"\\.test\\.mjs$\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs src/lib/*.test.mjs",
    "installer:desktop": "npm run package:desktop && electron-builder --win nsis --prepackaged \"out/Codex UI-win32-x64\""
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.50.0",
    "marked": "^18.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18"
  },
  "build": {
    "appId": "dev.codex-ui.desktop",
    "electronVersion": "44.7.0",
    "productName": "Codex UI",
    "directories": {
      "output": "out/installer"
    },
    "win": {
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Codex-UI-Setup-${version}.exe"
    }
  }
}
